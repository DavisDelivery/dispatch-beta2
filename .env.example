# ---------------------------------------------------------------------------
# dispatch-beta2 environment variables
# ---------------------------------------------------------------------------
# Copy to `.env` for local dev, or set these in the Netlify site UI for deploys.
#
# SERVER-SIDE (Netlify Functions runtime) — NEVER prefix with VITE_.
# These are read by netlify/functions/nuvizz.cjs and must NOT reach the client.
NUVIZZ_DAVIS_COMPANY_CODE=DAVIS
NUVIZZ_DAVIS_USER=
NUVIZZ_DAVIS_PASS=
NUVIZZ_BASE_URL=https://portal.nuvizz.com/deliverit/openapi/v7

# CLIENT-SIDE (baked into the bundle at build time) — safe to expose.
# Set to `true` to render the Stops page from the bundled fixture WITHOUT any
# NuVizz credentials (used for the first deploy preview before secrets exist).
VITE_USE_MOCK_NUVIZZ=false

# Google Maps JS API key (client, baked at build). Restrict by HTTP referrer in Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=
